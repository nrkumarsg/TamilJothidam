# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
# REQUIRED in production — the app refuses to boot without it rather than
# fall back to accepting requests from anywhere. Leave empty in development,
# where any origin is reflected.
# e.g. CORS_ORIGINS=https://jathakam.example.com,https://www.jathakam.example.com
CORS_ORIGINS=

# Database (Phase 2)
DATABASE_URL=postgresql://jathakam:jathakam_dev_password@localhost:5432/jathakam
# Prisma Migrate needs a non-pooled connection for its advisory locks. No
# pooler sits in front of local dev Postgres, so this is just the same value
# as DATABASE_URL — only a managed provider with connection pooling (Neon,
# Supabase, PgBouncer) needs a genuinely different DIRECT_URL. See
# docs/DEPLOYMENT.md.
DIRECT_URL=postgresql://jathakam:jathakam_dev_password@localhost:5432/jathakam

# Auth (Phase 17)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Password reset email (forgot-password flow) — sent via Resend
# (https://resend.com), raw HTTP API, no SDK. Create an API key at
# resend.com/api-keys. Leave RESEND_FROM_EMAIL unset to send from Resend's
# shared sandbox address (onboarding@resend.dev, works with no domain setup
# but only delivers to the email you signed up to Resend with) — verify
# your own domain there before going to production. Leave RESEND_API_KEY
# unset and forgot-password requests still succeed (never reveals whether
# an email is registered) but the email is only logged to the backend
# console, not actually sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google sign-in (spec: "add Gmail login"). Create OAuth 2.0 credentials at
# https://console.cloud.google.com/apis/credentials, add
# GOOGLE_REDIRECT_URI as an authorized redirect URI there. Leave
# GOOGLE_CLIENT_ID unset to disable — GET /auth/google then 503s with a
# clear message instead of the frontend's Google button silently failing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Where GET /auth/google/callback sends the browser back to after signing
# in (both success and failure) — the frontend's own origin.
FRONTEND_URL=http://localhost:3000

# Ayanamsa (Phase 4) - never change silently; stored per-chart in DB
DEFAULT_AYANAMSA=LAHIRI

# AI Providers (Phase 13) - configure the ones you use, never commit real keys.
# Only ANTHROPIC, DEEPSEEK and OLLAMA are actually implemented; OPENAI,
# GEMINI and NVIDIA_NIM are named here for the settings UI but throw
# NotImplementedException if selected (see ai/providers/unimplemented.provider.ts).
AI_DEFAULT_PROVIDER=deepseek
# Comma-separated fallback chain tried in order if the primary above fails
# (missing key, unreachable host, non-2xx response) — never fails the whole
# request just because one provider is down. Set to an empty string to
# disable fallback. Default when unset: ANTHROPIC,OLLAMA.
AI_FALLBACK_PROVIDERS=ANTHROPIC,OLLAMA
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_API_KEY=
NVIDIA_NIM_API_KEY=
# No API key — Ollama is a local (or self-hosted) server; reachability of
# OLLAMA_BASE_URL is the only availability check. The model must already be
# pulled there (`ollama pull llama3.1`) or Ollama 404s rather than fetching it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Prompt versioning (Phase 13)
ASTROLOGY_PROMPT_VERSION=1.0

# Geocoding / timezone lookup for place-of-birth search (Phase 3)
GEOCODING_PROVIDER=
GEOCODING_API_KEY=

# PDF generation (Phase 16) - drives a real Chromium-based browser already
# installed on the machine (puppeteer-core, no bundled Chromium download).
# Leave unset to auto-detect Edge/Chrome/Chromium at their usual install
# paths; set this only if yours isn't at one of those.
PUPPETEER_EXECUTABLE_PATH=

# Admin panel (Phase 18) - required only to use POST/GET/DELETE
# /admin/api-keys (AES-256-GCM encryption key for provider keys stored in
# the database). A long random string; any length works (SHA-256'd first).
API_KEY_ENCRYPTION_SECRET=
