# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/

# Env files (never commit secrets).
# Ignore every .env* variant, then re-admit the committed templates — so a
# new file like .env.production is excluded by default rather than only if
# someone remembered to add a rule for it.
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*

# Test / coverage
coverage/

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Prisma
backend/prisma/migrations/dev.db

# Portable local Postgres (no-admin dev DB fallback — see README)
.devdb/

# Generated PDF reports (Phase 16) — regenerable from DB data, not source
backend/generated-reports/

# Misc
*.tsbuildinfo
