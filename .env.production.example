# Template for docker-compose.prod.yml. Copy to .env.production, fill in
# real values, and keep it OUT of version control (.gitignore already
# excludes .env*).
#
# Generate each secret with something like:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# The API validates all of this at boot and refuses to start if anything
# below is missing or left at a placeholder — see
# backend/src/config/production-readiness.ts.

# --- Postgres (drop these if you point DATABASE_URL at a managed instance) --
POSTGRES_DB=jathakam
POSTGRES_USER=jathakam
POSTGRES_PASSWORD=

# Host `postgres` is the compose service name; change it for managed Postgres.
DATABASE_URL=postgresql://jathakam:CHANGE_ME@postgres:5432/jathakam
# Prisma Migrate needs a non-pooled connection for its advisory locks. The
# compose Postgres has no pooler in front of it, so this matches
# DATABASE_URL exactly — a managed provider with connection pooling (Neon,
# Supabase, PgBouncer) needs a genuinely different, non-pooled DIRECT_URL.
DIRECT_URL=postgresql://jathakam:CHANGE_ME@postgres:5432/jathakam

# --- Auth ------------------------------------------------------------------
# Must NOT be the placeholder from backend/.env.example, and at least 32
# characters — boot fails otherwise.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Secrets at rest -------------------------------------------------------
# Encrypts admin-managed AI provider keys (AES-256-GCM). Changing this makes
# every key already stored in the database unreadable.
API_KEY_ENCRYPTION_SECRET=

# --- Public URLs -----------------------------------------------------------
# Browser origins allowed to call the API.
CORS_ORIGINS=https://jathakam.example.com
# Where the API sends users after Google sign-in.
FRONTEND_URL=https://jathakam.example.com
# Baked into the frontend bundle AT BUILD TIME (see frontend/Dockerfile).
NEXT_PUBLIC_API_URL=https://api.jathakam.example.com

# Published host ports
API_PORT=4000
WEB_PORT=3000

# --- AI provider (optional; can also be set later via the admin panel) -----
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ASTROLOGY_PROMPT_VERSION=1.0

# --- Google sign-in (optional; set all three or none) ----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.jathakam.example.com/auth/google/callback

# --- Astrology -------------------------------------------------------------
DEFAULT_AYANAMSA=LAHIRI
